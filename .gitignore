# --- Unity generated ---
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Oo]bj/
/unity/[Bb]uild/
/unity/[Bb]uilds/
/unity/[Ll]ogs/
/unity/[Uu]ser[Ss]ettings/
/unity/[Mm]emoryCaptures/
/unity/[Rr]ecordings/

# Asset meta files are kept unless the asset itself is ignored
!/unity/[Aa]ssets/**/*.meta

# --- IDE files (regenerated by Unity / VS Code) ---
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.tmp

# --- Build artifacts ---
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# --- ML-Agents training output ---
/results/
/summaries/

# --- Data: raw Binance archives stay local; processed CSVs are committed ---
/data/raw/

# --- Evaluation: imported models and smoke evaluations stay local ---
/unity/Assets/Gym/Models/Imported/
/unity/Assets/Gym/Models/Imported.meta
/evaluations/smoke/

# --- Files Unity writes by itself during command-line runs (Q05) ---
/unity/Assets/ML-Agents/
/unity/Assets/ML-Agents.meta
/unity/ProjectSettings/SceneTemplateSettings.json

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- OS ---
.DS_Store
Thumbs.db
